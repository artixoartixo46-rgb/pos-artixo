{
  "name": "Artixo POS - Nightly Backup",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "1a1b2c3d-0001-4a00-8000-000000000001",
      "name": "Every night at 2am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tables = [\n  \"banks\",\"cheque_print_history\",\"cheques\",\"credit_customers\",\"credit_payment_history\",\n  \"locations\",\"product_categories\",\"product_price_tiers\",\"product_receiving\",\"products\",\n  \"sale_items\",\"sales\",\"stock_takes\",\"stock_take_items\",\"returns\",\"return_items\",\n  \"vendor_checkins\",\"vendor_checkin_items\",\"catalog_checkout_sessions\",\"settings\",\n  \"vendor_bills\",\"vendor_ledger\",\"vendors\"\n];\nreturn tables.map(t => ({ json: { table: t } }));"
      },
      "id": "1a1b2c3d-0002-4a00-8000-000000000002",
      "name": "List of tables",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT '{{$json[\"table\"]}}' as __backup_table, t.* FROM public.{{$json[\"table\"]}} t",
        "options": {}
      },
      "id": "1a1b2c3d-0003-4a00-8000-000000000003",
      "name": "Export each table",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [80, 0],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Supabase Postgres (set this up)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const grouped = {};\nfor (const item of items) {\n  const row = { ...item.json };\n  const table = row.__backup_table;\n  delete row.__backup_table;\n  if (!grouped[table]) grouped[table] = [];\n  grouped[table].push(row);\n}\nreturn [{ json: { generatedAt: new Date().toISOString(), backup: grouped } }];"
      },
      "id": "1a1b2c3d-0004-4a00-8000-000000000004",
      "name": "Combine into one backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 0]
    },
    {
      "parameters": {
        "operation": "toJson",
        "options": {
          "fileName": "=pos-artixo-backup-{{$now.format('yyyy-MM-dd')}}.json"
        }
      },
      "id": "1a1b2c3d-0005-4a00-8000-000000000005",
      "name": "Convert to file",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [560, 0]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=C:\\pos-artixo-backups\\pos-artixo-backup-{{$now.format('yyyy-MM-dd')}}.json",
        "options": {}
      },
      "id": "1a1b2c3d-0006-4a00-8000-000000000006",
      "name": "Save backup file to disk",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [800, 0]
    }
  ],
  "connections": {
    "Every night at 2am": {
      "main": [
        [
          {
            "node": "List of tables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List of tables": {
      "main": [
        [
          {
            "node": "Export each table",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Export each table": {
      "main": [
        [
          {
            "node": "Combine into one backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Combine into one backup": {
      "main": [
        [
          {
            "node": "Convert to file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert to file": {
      "main": [
        [
          {
            "node": "Save backup file to disk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
